<Window x:Class="VaultBridge.Windows.AddCredentialDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add credential" Width="420" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Site name"/><TextBox x:Name="TitleBox" Margin="0,3,0,10" Height="28"/>
    <TextBlock Text="Website URL"/><TextBox x:Name="UrlBox" Margin="0,3,0,10" Height="28"/>
    <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Margin="0,3,0,10" Height="28"/>
    <TextBlock Text="Password"/><PasswordBox x:Name="SecretBox" Margin="0,3,0,10" Height="28"/>
    <TextBlock Text="Notes"/><TextBox x:Name="NotesBox" Margin="0,3,0,14" Height="28"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" Padding="14,7" Margin="0,0,8,0"/>
      <Button Content="Save" Click="Save_Click" Padding="14,7"/>
    </StackPanel>
  </StackPanel>
</Window>
